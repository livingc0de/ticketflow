      "Bash(git push *+main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *branches/*/protection*)",
      "Bash(gh api graphql *Ruleset*)",
      "Bash(gh api graphql *BranchProtectionRule*)",
      "Bash(*protect.mjs --apply*)"
    ]
  },
  "manifest_version": 1
