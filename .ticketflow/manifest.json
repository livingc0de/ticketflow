{
  "claude_settings": {
    "allow": [
      "Bash(node core/scripts/issue.mjs *)",
      "Bash(node core/scripts/project.mjs *)",
      "Bash(node core/scripts/sub-issue.mjs *)",
      "Bash(node core/scripts/tracker-next.mjs *)",
      "Bash(node core/scripts/queue.mjs *)",
      "Bash(node core/scripts/pr-wait.mjs *)",
      "Bash(node core/scripts/local-verify.mjs *)",
      "Bash(node core/scripts/merge.mjs *)",
      "Bash(node core/scripts/thread.mjs *)",
      "Bash(node core/scripts/debt.mjs *)",
      "Bash(node core/scripts/gen-stubs.mjs *)",
      "Bash(node core/scripts/doctor.mjs *)"
    ],
    "ask": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
