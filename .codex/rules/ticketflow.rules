# Generated by ticketflow render from the guard list. Do not edit: change the source, run render.
# Generated from core/guard.json: do not edit.
prefix_rule(
    pattern = ["gh","pr","merge"],
    decision = "prompt",
    justification = "gh pr merge skips the checks the merge script makes (gate on the exact head, up to date, review gate). Use core/scripts/merge.mjs <pr>.",
    match = ["gh pr merge 5 --admin","gh pr merge 5 --squash --match-head-commit abc1234"],
    not_match = ["core/scripts/merge.mjs 5","gh pr view 5"],
)

prefix_rule(
    pattern = ["git","push",["origin"],["main","HEAD:main","+main","main:main"]],
    decision = "prompt",
    justification = "Nothing is pushed to main directly. Push a branch, open a pull request and merge it with core/scripts/merge.mjs <pr>.",
    match = ["git push origin main","git push origin HEAD:main","git push origin +main"],
    not_match = ["git push -u origin main","git push --force origin main","git push origin feat:refs/heads/main","git push --mirror origin","git push origin feat/x","git push -u origin feat/main-fix","git commit -m \"git push origin main\""],
)

prefix_rule(
    pattern = ["core/scripts/protect.mjs","--apply"],
    decision = "prompt",
    justification = "Branch protection and rulesets change only through core/scripts/protect.mjs --apply, on the owner's request.",
    match = ["core/scripts/protect.mjs --apply"],
    not_match = ["gh api -X PUT repos/o/r/rulesets/12 --input ruleset.json","gh api repos/o/r/rulesets","gh api -X DELETE repos/o/r/branches/main/protection","gh api graphql -f query='mutation { updateBranchProtectionRule(input:{}) { clientMutationId } }'","node core/scripts/protect.mjs --apply --migrate-classic","node core/scripts/protect.mjs --apply --replace-context ci/gate","node core/scripts/protect.mjs --apply --migrate-classic --replace-context ci/gate","node core/scripts/protect.mjs --apply --squash-only --branch-settings","node core/scripts/protect.mjs --replace-context ci/gate","core/scripts/protect.mjs","gh api repos/o/r/issues/5/comments -f body=\"see rulesets and branches/main/protection\"","gh api graphql -f query='query{repository(owner:\"o\",name:\"r\"){rulesets(first:5){nodes{name}}}}'","gh pr comment 5 --body-file - <<'EOF'\ngit push -u origin main\nEOF"],
)

prefix_rule(
    pattern = ["node","core/scripts/protect.mjs","--apply"],
    decision = "prompt",
    justification = "Branch protection and rulesets change only through core/scripts/protect.mjs --apply, on the owner's request.",
    match = ["node core/scripts/protect.mjs --apply --migrate-classic","node core/scripts/protect.mjs --apply --replace-context ci/gate","node core/scripts/protect.mjs --apply --migrate-classic --replace-context ci/gate","node core/scripts/protect.mjs --apply --squash-only --branch-settings"],
    not_match = ["gh api -X PUT repos/o/r/rulesets/12 --input ruleset.json","gh api repos/o/r/rulesets","gh api -X DELETE repos/o/r/branches/main/protection","gh api graphql -f query='mutation { updateBranchProtectionRule(input:{}) { clientMutationId } }'","core/scripts/protect.mjs --apply","node core/scripts/protect.mjs --replace-context ci/gate","core/scripts/protect.mjs","gh api repos/o/r/issues/5/comments -f body=\"see rulesets and branches/main/protection\"","gh api graphql -f query='query{repository(owner:\"o\",name:\"r\"){rulesets(first:5){nodes{name}}}}'","gh pr comment 5 --body-file - <<'EOF'\ngit push -u origin main\nEOF"],
)
