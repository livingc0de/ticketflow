{
  "skill": { "target": ".agents/skills/{name}/SKILL.md", "format": "md", "body": "pointer" },
  "role": { "target": ".cursor/agents/{name}.md", "format": "md", "body": "pointer", "fields": { "name": "name", "description": "description", "model": "model" } },
  "plugin": {
    "manifest": {
      "path": ".cursor-plugin/plugin.json",
      "json": {
        "name": "ticketflow",
        "version": "{version}",
        "description": "An agent-neutral, ticket-driven delivery workflow for GitHub repos: set it up with init, update it with sync.",
        "author": { "name": "ticketflow" },
        "repository": "{repo_url}",
        "license": "MIT",
        "keywords": ["workflow", "github", "tickets", "pull-requests"],
        "skills": "./skills/"
      }
    },
    "marketplace": {
      "path": ".cursor-plugin/marketplace.json",
      "json": {
        "name": "ticketflow",
        "owner": { "name": "ticketflow" },
        "plugins": [
          { "name": "ticketflow", "source": "./", "version": "{version}", "description": "Set up and update the TicketFlow workflow in a GitHub repo." }
        ]
      }
    }
  }
}
