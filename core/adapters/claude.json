{
  "skill": { "target": ".claude/skills/{name}/SKILL.md", "format": "md", "body": "pointer" },
  "rule": ".claude/rules/{name}.md",
  "role": { "target": ".claude/agents/{name}.md", "format": "md", "body": "pointer", "fields": { "name": "name", "description": "description", "model": "model", "effort": "effort" }, "tools": { "read-only": "tools: Bash, Read, Grep, Glob, Skill", "full": null } },
  "plugin": {
    "manifest": {
      "path": ".claude-plugin/plugin.json",
      "json": {
        "name": "ticketflow",
        "version": "{version}",
        "description": "An agent-neutral, ticket-driven delivery workflow for GitHub repos: set it up with init, update it with sync.",
        "repository": "{repo_url}",
        "license": "MIT",
        "keywords": ["workflow", "github", "tickets", "pull-requests"]
      }
    },
    "marketplace": {
      "path": ".claude-plugin/marketplace.json",
      "json": {
        "name": "ticketflow",
        "owner": { "name": "ticketflow" },
        "plugins": [
          { "name": "ticketflow", "source": "./", "version": "{version}", "description": "Set up and update the TicketFlow workflow in a GitHub repo.", "category": "development" }
        ]
      }
    }
  }
}
